<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{% block description %}JarvishStack — Lightweight PHP MVC Framework{% endblock %}">
    <title>{% block title %}JarvishStack{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block head %}{% endblock %}
</head>
<body>

    <header class="navbar">
        <div class="container navbar-inner">
            <a href="/" class="navbar-brand">
                <span class="brand-icon">⚡</span>
                JarvishStack
                <span class="brand-version">v1.0</span>
            </a>
            <button class="navbar-toggle" id="navToggle" aria-label="Open navigation" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>
            <nav class="navbar-nav" id="navMenu" role="navigation">
                <a href="/"        class="nav-link">Home</a>
                {% if tablesReady.users %}
                <a href="/users"   class="nav-link">Users</a>
                {% endif %}
                {% if tablesReady.contacts %}
                <a href="/contacts"class="nav-link">Submissions</a>
                {% endif %}
                <a href="/docs"    class="nav-link">Docs</a>
                <a href="/contact" class="nav-link nav-cta">Contact</a>
            </nav>
        </div>
    </header>
    <div class="navbar-gradient"></div>

    <main class="main-content">
        {% block body %}{% endblock %}
    </main>

    <footer class="footer">
        <div class="footer-gradient"></div>
        <div class="container">
            <div class="footer-inner">
                <span class="footer-brand">⚡ JarvishStack</span>
                <nav class="footer-links">
                    <a href="/">Home</a>
                    <a href="/docs">Docs</a>
                    <a href="/contact">Contact</a>
                </nav>
                <span class="footer-copy">&copy; {{ "now"|date("Y") }} — Built with PHP &amp; Symfony</span>
            </div>
        </div>
    </footer>

    <script src="{{ asset('js/script.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
