{% extends 'base.html.twig' %}

{% block title %}Contact Submissions — JarvishStack{% endblock %}

{% block body %}
<div class="container">
    <div class="page-header">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
            <div>
                <h1>Contact Submissions</h1>
                <p>Messages submitted via the contact form, newest first.</p>
            </div>
            {% if contacts is not empty %}
                <span class="badge">{{ contacts|length }} submission{{ contacts|length != 1 ? 's' : '' }}</span>
            {% endif %}
        </div>
    </div>

    {% if contacts is empty %}
        <div class="empty-state">
            <div class="empty-state-icon">📭</div>
            <p>No submissions yet. <a href="/contact">Send the first one →</a></p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width:50px">#</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th style="width:180px">Submitted At</th>
                    </tr>
                </thead>
                <tbody>
                    {% for contact in contacts %}
                    <tr>
                        <td class="td-num">{{ loop.index }}</td>
                        <td class="td-mono">{{ contact.email }}</td>
                        <td>{{ contact.subject }}</td>
                        <td class="td-mono text-muted" style="font-size:.8125rem">{{ contact.created_at }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
