{% extends 'base.html.twig' %}

{% block title %}Users — JarvishStack{% endblock %}

{% block body %}
<div class="container">
    <div class="page-header">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem">
            <div>
                <h1>Users</h1>
                <p>All records from the <code>users</code> table.</p>
            </div>
            {% if users is not empty %}
                <span class="badge">{{ users|length }} user{{ users|length != 1 ? 's' : '' }}</span>
            {% endif %}
        </div>
    </div>

    {% if users is empty %}
        <div class="empty-state">
            <div class="empty-state-icon">👤</div>
            <p>No users found in the database.</p>
        </div>
    {% else %}
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width:60px">#</th>
                        <th>Name</th>
                        <th>Email</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="td-num">{{ loop.index }}</td>
                        <td><strong>{{ user.name }}</strong></td>
                        <td class="td-mono">{{ user.email }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
